<!doctype html>
<html lang="en" data-resolution="portrait">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1080, height=1920" />
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <style>
      :root { --ground: #07080b; --ink: #f6f2ee; --muted: #e4e0da; --blue: #9fc4ff; --lime: #c6ff3d; --red: #ff5a3c;
              --font-display: "Oswald"; --font-cap: "Montserrat"; --font-mono: "JetBrains Mono"; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      html, body { margin: 0; width: 1080px; height: 1920px; overflow: hidden; background: var(--ground); }
      #root { position: relative; width: 100%; height: 100%; overflow: hidden; font-family: var(--font-display); color: var(--ink); }
      #bg { position: absolute; inset: 0; background: #000; }
      #stage { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; }
      #scrim { position: absolute; left: 0; top: 0; width: 1080px; height: 700px; background: linear-gradient(180deg, rgba(4,6,10,0.62) 0%, rgba(4,6,10,0.34) 55%, rgba(4,6,10,0) 100%); }
      #bscrim { position: absolute; left: 0; top: 1360px; width: 1080px; height: 560px; background: linear-gradient(0deg, rgba(4,6,10,0.45) 0%, rgba(4,6,10,0.2) 60%, rgba(4,6,10,0) 100%); }
      #endscrim { position: absolute; left: 0; top: 0; width: 1080px; height: 1920px; background: rgba(5,7,10,0.78); }

      #hook { position: absolute; left: 30px; right: 30px; top: 110px; text-align: center; text-transform: uppercase; text-shadow: 0 6px 30px rgba(0,0,0,0.85); }
      #hook .a { font-size: 112px; line-height: 1; font-weight: 700; letter-spacing: 0.01em; }
      #hook .b { font-size: 196px; line-height: 0.98; font-weight: 700; color: var(--lime); }
      #hook .c { font-size: 74px; line-height: 1.05; font-weight: 700; color: #fff; margin-top: 18px; }
      #hook .c span { background: var(--red); padding: 2px 22px 6px; border-radius: 10px; text-shadow: none; }

      .cw { position: absolute; left: 30px; right: 30px; top: 1560px; text-align: center; }
      .cw span { display: inline-block; font-family: var(--font-cap); font-weight: 900; font-size: 80px; line-height: 1.05; color: #fff;
                 -webkit-text-stroke: 14px #000; paint-order: stroke fill; letter-spacing: 0.01em; text-shadow: 0 8px 22px rgba(0,0,0,0.55); }
      .cw b { color: var(--lime); font-weight: 900; }

      .call { position: absolute; left: 40px; right: 40px; top: 120px; text-align: center; text-shadow: 0 6px 28px rgba(0,0,0,0.85); }
      .call .k { font-family: var(--font-mono); font-size: 34px; letter-spacing: 0.12em; color: var(--muted); font-weight: 700; }
      .call .big { font-size: 170px; font-weight: 700; line-height: 1; margin-top: 6px; font-variant-numeric: tabular-nums; color: #fff; }
      .call .big small { font-size: 80px; }
      .call .sub { font-family: var(--font-mono); font-size: 34px; color: #fff; margin-top: 14px; font-weight: 700; line-height: 1.3; }
      .call.l .big { color: var(--lime); } .call.r .big { color: var(--red); }
      .call.sm .big { font-size: 128px; }

      .bars { position: absolute; left: 70px; right: 70px; top: 470px; text-shadow: 0 6px 24px rgba(0,0,0,0.9); }
      .bars .row { position: relative; height: 104px; margin-top: 14px; }
      .bars .lbl { position: absolute; left: 0; top: 0; font-family: var(--font-mono); font-size: 32px; font-weight: 700; color: #fff; }
      .bars .trk { position: absolute; left: 0; right: 0; top: 44px; height: 52px; border-radius: 10px; background: rgba(255,255,255,0.14); }
      .bars .fill { position: absolute; left: 0; top: 44px; height: 52px; border-radius: 10px; transform-origin: 0 50%; background: #9aa0a8; }
      .bars .val { position: absolute; right: 0; top: -14px; font-size: 62px; font-weight: 700; font-variant-numeric: tabular-nums; color: #dfe2e6; }
      .bars .row.hi .fill { background: var(--lime); } .bars .row.hi .val, .bars .row.hi .lbl { color: var(--lime); }

      .lab { position: absolute; left: 0; top: 0; }
      .lab span { position: absolute; transform: translate(-50%, -50%); white-space: nowrap; text-align: center; font-family: var(--font-mono); font-size: 34px; font-weight: 700; line-height: 1.2;
                  color: var(--lime); background: rgba(8,8,10,0.82); border: 3px solid var(--lime); border-radius: 14px; padding: 6px 16px; }
      .lab i { position: absolute; height: 4px; background: var(--lime); transform-origin: 0 50%; box-shadow: 0 0 8px rgba(0,0,0,0.7); }
      .lab.w span { color: #fff; border-color: #fff; } .lab.w i { background: #fff; }
      .lab.big span { font-size: 46px; padding: 6px 20px; }
      .lab.n span { font-size: 40px; width: 70px; height: 70px; padding: 0; line-height: 64px; border-radius: 40px; }

      #map { position: absolute; left: 90px; top: 420px; width: 900px; height: 560px; }
      #map svg { width: 900px; height: 560px; overflow: visible; }
      #map .city { fill: #fff; stroke: #0a0b0d; stroke-width: 4; }
      #map .hub { fill: var(--lime); stroke: #0a0b0d; stroke-width: 6; }
      #map .hl { stroke: var(--lime); stroke-width: 16; stroke-linecap: round; }
      #map .sp { stroke: rgba(255,255,255,0.85); stroke-width: 6; stroke-linecap: round; }
      #map .dl { stroke: var(--lime); stroke-width: 6; stroke-linecap: round; }
      #map text { font-family: var(--font-mono); font-weight: 700; font-size: 30px; fill: #0a0b0d; }

      #seats { position: absolute; left: 115px; top: 520px; width: 850px; }
      #seats .grid { display: grid; grid-template-columns: repeat(25, 30px); gap: 4px; justify-content: center; background: rgba(6,8,12,0.72); border-radius: 22px; padding: 26px; }
      #seats .s { width: 30px; height: 30px; border-radius: 7px 7px 4px 4px; background: rgba(255,255,255,0.18); }

      #end { position: absolute; left: 40px; right: 40px; top: 640px; text-align: center; text-shadow: 0 4px 24px rgba(0,0,0,0.85); }
      #end .t { font-size: 132px; font-weight: 700; line-height: 1.0; letter-spacing: 0.01em; }
      #end .t .g { color: var(--lime); }
      #end .cta { display: inline-flex; align-items: center; margin-top: 70px; }
      #end .cta .sub { font-family: var(--font-mono); font-size: 38px; font-weight: 700; letter-spacing: 0.06em; color: #fff; background: #ff0033; border-radius: 44px; padding: 14px 38px; box-shadow: 0 6px 24px rgba(255,0,51,0.45); }
      #end .d { font-family: var(--font-mono); font-size: 30px; color: var(--muted); margin-top: 60px; }
    </style>
  </head>
  <body>
    <div id="root" data-composition-id="main" data-start="0" data-duration="%DUR%" data-width="1080" data-height="1920">
      <div id="bg" class="clip" data-start="0" data-duration="%DUR%" data-track-index="0"></div>
      <canvas id="stage" class="clip" data-start="0" data-duration="%DUR%" data-track-index="1" width="1080" height="1920"></canvas>
      <div id="scrim" class="clip" data-start="0" data-duration="%DUR%" data-track-index="5" data-layout-ignore></div>
      <div id="bscrim" class="clip" data-start="0" data-duration="%DUR%" data-track-index="5" data-layout-ignore></div>
      <div id="endscrim" class="clip" data-start="%T_endsc%" data-duration="%T_endscd%" data-track-index="5" data-layout-ignore></div>

      <div id="hook" class="clip" data-start="0.0" data-duration="%T_name%" data-track-index="2">
        <div class="a" id="hook-a">THE BIGGEST AIRLINER</div>
        <div class="b" id="hook-b">EVER BUILT</div>
        <div class="c" id="hook-c"><span>AIRBUS STOPPED MAKING IT</span></div>
      </div>

      <div id="c-name" class="clip call l sm" data-start="%T_name%" data-duration="%D_name%" data-track-index="2">
        <div class="k" id="c-name-k">AIRBUS · FIRST FLIGHT 2005</div>
        <div class="big" id="c-name-big">A380</div>
        <div class="sub" id="c-name-sub">525 SEATS TYPICAL · 853 CERTIFIED MAX</div>
      </div>

      <div id="c-cmp" class="clip call sm" data-start="%T_next%" data-duration="%D_cmp%" data-track-index="2">
        <div class="k" id="c-cmp-k">TOP VIEW · TO SCALE</div>
        <div class="big" id="c-cmp-big">A380 <small>vs</small> 777</div>
      </div>

      <div id="c-bet" class="clip call sm" data-start="%T_bet%" data-duration="%D_bet%" data-track-index="2">
        <div class="k" id="c-bet-k">AIRBUS'S BET</div>
        <div class="big" id="c-bet-big">HUB TO HUB</div>
      </div>
      <div id="c-p2p" class="clip call l sm" data-start="%T_instead%" data-duration="%D_p2p%" data-track-index="2">
        <div class="k" id="c-p2p-k">WHAT AIRLINES DID</div>
        <div class="big" id="c-p2p-big">DIRECT</div>
      </div>
      <div id="map" class="clip" data-start="%T_bet%" data-duration="%D_map%" data-track-index="3" data-layout-ignore>
        <svg viewBox="0 0 900 560">
          <g id="map-hub">
            <line class="sp" x1="200" y1="300" x2="60" y2="120" /><line class="sp" x1="200" y1="300" x2="40" y2="330" /><line class="sp" x1="200" y1="300" x2="110" y2="500" />
            <line class="sp" x1="200" y1="300" x2="300" y2="80" /><line class="sp" x1="200" y1="300" x2="330" y2="520" />
            <line class="sp" x1="700" y1="260" x2="600" y2="60" /><line class="sp" x1="700" y1="260" x2="860" y2="110" /><line class="sp" x1="700" y1="260" x2="870" y2="380" />
            <line class="sp" x1="700" y1="260" x2="760" y2="520" /><line class="sp" x1="700" y1="260" x2="560" y2="480" />
            <line class="hl" id="map-hl" x1="200" y1="300" x2="700" y2="260" />
          </g>
          <g id="map-p2p">
            <line class="dl" x1="60" y1="120" x2="860" y2="110" /><line class="dl" x1="40" y1="330" x2="870" y2="380" /><line class="dl" x1="110" y1="500" x2="600" y2="60" />
            <line class="dl" x1="300" y1="80" x2="760" y2="520" /><line class="dl" x1="330" y1="520" x2="860" y2="110" /><line class="dl" x1="60" y1="120" x2="560" y2="480" />
            <line class="dl" x1="40" y1="330" x2="600" y2="60" />
          </g>
          <g id="map-nodes">
            <circle class="city" cx="60" cy="120" r="16" /><circle class="city" cx="40" cy="330" r="16" /><circle class="city" cx="110" cy="500" r="16" /><circle class="city" cx="300" cy="80" r="16" />
            <circle class="city" cx="330" cy="520" r="16" /><circle class="city" cx="600" cy="60" r="16" /><circle class="city" cx="860" cy="110" r="16" /><circle class="city" cx="870" cy="380" r="16" />
            <circle class="city" cx="760" cy="520" r="16" /><circle class="city" cx="560" cy="480" r="16" />
            <g id="map-hubs"><circle class="hub" cx="200" cy="300" r="50" /><circle class="hub" cx="700" cy="260" r="50" />
              <text x="200" y="311" text-anchor="middle">HUB</text><text x="700" y="271" text-anchor="middle">HUB</text></g>
          </g>
        </svg>
      </div>
      <div id="c-twin" class="clip call sm" data-start="%T_twin%" data-duration="%D_twin%" data-track-index="2">
        <div class="k" id="c-twin-k">BOEING 777 · 787 · AIRBUS A350</div>
        <div class="big" id="c-twin-big">2 ENGINES</div>
        <div class="sub" id="c-twin-sub">SMALLER · CHEAPER TO FILL</div>
      </div>

      <div id="c-four" class="clip call r sm" data-start="%T_four%" data-duration="%D_four%" data-track-index="2">
        <div class="k" id="c-four-k">EVERY A380 FLIGHT</div>
        <div class="big" id="c-four-big">4 ENGINES</div>
        <div class="sub" id="c-four-sub">MORE FUEL · MORE MAINTENANCE</div>
      </div>

      <div id="c-seats" class="clip call sm" data-start="%T_seats%" data-duration="%D_seats%" data-track-index="2">
        <div class="k" id="c-seats-k">TO FILL · EVERY FLIGHT · EVERY DAY</div>
        <div class="big" id="c-seats-big">525 SEATS</div>
      </div>
      <div id="seats" class="clip" data-start="%T_seats%" data-duration="%D_seats%" data-track-index="3" data-layout-ignore>
        <div class="grid" id="seat-grid">%SEATS%</div>
      </div>

      <div id="c-end" class="clip call sm" data-start="%T_pulled%" data-duration="%D_endc%" data-track-index="2">
        <div class="k" id="c-end-k">AIRBUS · FEBRUARY 2019</div>
        <div class="big" id="c-end-big">PRODUCTION ENDS</div>
      </div>
      <div id="c-251" class="clip call l" data-start="%T_last%" data-duration="%D_251%" data-track-index="2">
        <div class="k" id="c-251-k">DELIVERED · LAST ONE DEC 2021</div>
        <div class="big" id="c-251-big"><span id="c-251-n">0</span></div>
        <div class="sub" id="c-251-sub">A380s</div>
      </div>
      <div id="c-emi" class="clip call sm" data-start="%T_emi%" data-duration="%D_emi%" data-track-index="2">
        <div class="k" id="c-emi-k">WHO TOOK THEM</div>
        <div class="big" id="c-emi-big">EMIRATES</div>
      </div>
      <div id="emi" class="clip bars" data-start="%T_emi%" data-duration="%D_emi%" data-track-index="2">
        <div class="row hi" id="emi-a"><div class="lbl">EMIRATES</div><div class="trk"></div><div class="fill" id="emi-a-fill" style="width:49%"></div><div class="val">123</div></div>
        <div class="row" id="emi-b"><div class="lbl">EVERY OTHER AIRLINE</div><div class="trk"></div><div class="fill" id="emi-b-fill" style="width:51%"></div><div class="val">128</div></div>
      </div>

%LABS%

      <div id="end" class="clip" data-start="%T_end%" data-duration="%T_endd%" data-track-index="2">
        <div class="t" id="end-t"><span class="g">TOO BIG</span><br />FOR THE WAY<br />WE FLY.</div>
        <div class="cta" id="end-cta"><span class="sub" id="end-sub">SUBSCRIBE</span></div>
        <div class="d" id="end-d">Unofficial simplified 3D visualisation</div>
      </div>

      <!-- word-by-word captions, timed from the ElevenLabs voice alignment -->
%CAPS%

      <!-- Voiceover (ElevenLabs "Adam"), ducked music, takeoff roar and a fly-by. Closing hit and loudness are done in mix.py. -->
%AUDIO%
    </div>

    <script>
      const LN = Math.log, DUR = %DUR%;
      const S = { aOn: 1, bOn: 0, ax: 0, ay: 0, az: 0, aYaw: 0, aPitch: 0, aRoll: 0, bx: 0, by: 0, bz: 0, bYaw: 0, bPitch: 0, bRoll: 0, ground: 1,
                  tx: 0, ty: 8, tz: 0, camAz: -150, camEl: 3, logD: LN(170), fov: 30, camRoll: 0, envRot: 0, sunAz: 140, sunEl: 42, shadowR: 80, sfx: 0, sfz: 0,
                  dimA: 0, dimB: 0, spanA: 0, spanB: 0, labSide: -1, exp: 1, ao: 1, bloom: 0.12 };
      const st = gsap.timeline({ paused: true });
      const move = (t, d, props, ease = "sine.inOut") => st.to(S, { ...props, duration: d, ease }, t);
      const set = (t, props) => st.set(S, props, t);
      const sky = (t) => set(t, { ground: 0, ay: 0, ax: 0, az: 0, by: 0, bx: 0, bz: 0, aPitch: 0, bPitch: 0, aRoll: 0, bRoll: 0, envRot: 0 });

      // HOOK: rolling down the runway at ~80 m/s, rotates and lifts off. Camera in front-left, tracking.
      set(0, { aOn: 1, bOn: 0, ground: 1, ax: 0, az: 130, ay: 0, aPitch: 0, aYaw: 0, tx: 0, tz: 130, ty: 11, camAz: -152, camEl: 2.5, logD: LN(185), fov: 30, sfz: 130, sunAz: 20, sunEl: 34 });
      move(0, %T_name%, { az: -230, tz: -230, sfz: -230 }, "none");
      move(0, %T_name%, { camAz: -112, logD: LN(150), camEl: 4 }, "sine.inOut");
      move(1.7, 1.4, { aPitch: 8.5 }, "sine.inOut");
      move(3.1, %T_name% - 3.1, { aPitch: 10.5 }, "sine.out");
      move(3.0, %T_name% - 3.0, { ay: 12, ty: 19 }, "power2.in");
      // NAME: parked on the runway, front-quarter orbit; decks labelled; then low front view of the four engines
      set(%T_name%, { ax: 0, az: 0, ay: 0, aPitch: 0, sfz: 0, tx: 0, tz: -6, ty: 9, camAz: -146, camEl: 3, logD: LN(150), sunAz: 20, sunEl: 34, labSide: -1 });
      move(%T_name%, %T_engines% - %T_name%, { camAz: -128, logD: LN(135), tz: -2 }, "sine.inOut");
      set(%T_engines%, { sunAz: 30, sunEl: 32, tx: 0, tz: -10, ty: 5.5, camAz: -180, camEl: 1.0, logD: LN(330), fov: 27 });
      move(%T_engines%, %T_seats1% - %T_engines%, { logD: LN(305) }, "sine.inOut");
      set(%T_seats1%, { sunAz: 60, sunEl: 34, tx: 0, tz: 0, ty: 9, camAz: -96, camEl: 2, logD: LN(170), fov: 30 });
      move(%T_seats1%, %T_next% - %T_seats1%, { camEl: 9, logD: LN(185), camAz: -88 }, "sine.inOut");
      // COMPARE: both parked on the apron, noses pointing right on screen, tails aligned; top-down
      set(%T_next%, { bOn: 1, ax: %AX%, az: -46, aYaw: -90, bx: %BX%, bz: 42, bYaw: -90, tx: %CX%, ty: 0, tz: -5, camAz: 0, camEl: 80, logD: LN(690), fov: 30, sfx: %CX%, sfz: 0, shadowR: 140, sunAz: 150, sunEl: 55, dimA: 0, dimB: 0, spanA: 0, spanB: 0 });
      move(%T_next%, %T_bet% - %T_next%, { logD: LN(670) }, "sine.inOut");
      move(%T_short%, 0.9, { dimA: 1, dimB: 1 }, "power2.out");
      move(%T_wider%, 0.9, { spanA: 1, spanB: 1 }, "power2.out");
      // BET: A380 cruising, seen from below; route map on top
      sky(%T_bet%); set(%T_bet%, { aOn: 1, bOn: 0, aYaw: -60, aRoll: -6, dimA: 0, dimB: 0, spanA: 0, spanB: 0, tx: 0, ty: 30, tz: 0, camAz: 160, camEl: -22, logD: LN(235), fov: 30, sunAz: 200, sunEl: 60, shadowR: 80, sfx: 0, sfz: 0, envRot: 40 });
      move(%T_bet%, %T_instead% - %T_bet%, { camAz: 128, aRoll: -10, logD: LN(190) }, "sine.inOut");
      // TWINS: a 777 passes
      set(%T_instead%, { aOn: 0, bOn: 1, bYaw: 70, bRoll: 8, tx: 0, ty: 20, tz: 0, camAz: -30, camEl: -18, logD: LN(170), envRot: 90 });
      move(%T_instead%, %T_four% - %T_instead%, { camAz: -75, bRoll: 4, logD: LN(150) }, "sine.inOut");
      // FOUR ENGINES: low head-on on the runway
      set(%T_four%, { ground: 1, aOn: 1, bOn: 0, ax: 0, az: 0, ay: 0, aYaw: 0, aRoll: 0, aPitch: 0, envRot: 0, tx: 0, tz: -12, ty: 9, camAz: 180, camEl: 0.8, logD: LN(330), fov: 27, sunAz: 30, sunEl: 32, sfz: 0 });
      move(%T_four%, %T_seats% - %T_four%, { logD: LN(290), ty: 8.5 }, "sine.inOut");
      // SEATS: tight side view of the double deck, dimmed under the seat map
      set(%T_seats%, { sunAz: 60, sunEl: 34, tx: 0, tz: -14, ty: 8, camAz: -92, camEl: 4, logD: LN(120), fov: 30, exp: 0.75 });
      move(%T_seats%, %T_pulled% - %T_seats%, { tz: 6, logD: LN(112) }, "none");
      // END: alone on the apron, slow crane up and away
      set(%T_pulled%, { ax: 600, az: 0, aYaw: -35, tx: 600, tz: 0, ty: 8, sfx: 600, sfz: 0, camAz: -150, camEl: 6, logD: LN(150), fov: 30, exp: 0.95, sunAz: 30, sunEl: 28, sunG: 0.86, sunB: 0.7, shadowR: 120 });
      move(%T_pulled%, %T_too% - %T_pulled%, { camEl: 24, logD: LN(260), camAz: -175 }, "sine.inOut");
      // FINAL: climbing away into the sky
      sky(%T_too%); set(%T_too%, { aOn: 1, bOn: 0, aYaw: 0, aPitch: 9, aRoll: 0, tx: 0, ty: 6, tz: 0, camAz: 20, camEl: -12, logD: LN(150), fov: 30, envRot: 200, sunAz: 150, sunEl: 40, sunG: 0.9, sunB: 0.8, exp: 1 });
      move(%T_too%, DUR - %T_too%, { logD: LN(330), camAz: 5, camEl: -9, aRoll: 4 }, "sine.inOut");
      st.set({}, {}, DUR);
      window.aStateAt = (t) => { st.seek(t, false); return { ...S, t }; };

      // ---------- Text ----------
      const tl = gsap.timeline({ paused: true });
      const fade = (sel, t, d = 0.3) => tl.fromTo(sel, { opacity: 0 }, { opacity: 1, duration: d }, t);
      tl.fromTo("#hook-a", { y: -12 }, { y: 0, duration: 0.25, ease: "power3.out" }, 0.0);
      tl.fromTo("#hook-b", { scale: 1.08 }, { scale: 1, duration: 0.4, ease: "power3.out" }, 0.0);
      tl.fromTo("#hook-c", { opacity: 0, scale: 1.3 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, %T_stopped%);
      %CAPT%.forEach((t, k) => tl.fromTo(`#cw-${k}-t`, { scale: 0.86 }, { scale: 1, duration: 0.12, ease: "back.out(2)" }, t));
      const pop = (k, t) => { tl.fromTo(`#${k}-k`, { opacity: 0, y: 14 }, { opacity: 1, y: 0, duration: 0.25, ease: "power3.out" }, t); tl.fromTo(`#${k}-big`, { opacity: 0, scale: 1.25 }, { opacity: 1, scale: 1, duration: 0.25, ease: "power3.out" }, t + 0.05); };
      const count = (id, to, t, d, dec = 0, ease = "power2.out") => { const o = { n: 0 }; tl.fromTo(o, { n: 0 }, { n: to, duration: d, ease, onUpdate: () => { document.getElementById(id).textContent = o.n.toFixed(dec); } }, t); };
      const bar = (id, t, d = 0.7) => tl.fromTo(id, { scaleX: 0 }, { scaleX: 1, duration: d, ease: "power3.out" }, t);
      pop("c-name", %T_name%); fade("#c-name-sub", %T_seats1% - 0.1);
      pop("c-cmp", %T_next%);
      pop("c-bet", %T_bet%); fade("#map", %T_bet%, 0.3);
      tl.fromTo("#map-p2p", { opacity: 0 }, { opacity: 0, duration: 0.01 }, %T_bet%);
      tl.fromTo("#map-hl", { attr: { x2: 200, y2: 300 } }, { attr: { x2: 700, y2: 260 }, duration: 0.8, ease: "power2.inOut" }, %T_hub% - 0.6);
      tl.to("#map-hub", { opacity: 0.12, duration: 0.4 }, %T_direct% - 0.4); tl.to("#map-hubs", { opacity: 0, duration: 0.4 }, %T_direct% - 0.4);
      tl.fromTo("#map-p2p", { opacity: 0 }, { opacity: 1, duration: 0.5 }, %T_direct% - 0.3);
      pop("c-p2p", %T_instead%);
      pop("c-twin", %T_twin%); fade("#c-twin-sub", %T_twin% + 0.4);
      pop("c-four", %T_four%); fade("#c-four-sub", %T_fuel% - 0.1);
      pop("c-seats", %T_seats%); fade("#seat-grid", %T_seats%, 0.3);
      %SEATJS%
      pop("c-end", %T_pulled%);
      pop("c-251", %T_last%); count("c-251-n", 251, %T_last% + 0.1, %T_251% - %T_last% + 0.4); fade("#c-251-sub", %T_251%);
      pop("c-emi", %T_emi%); fade("#emi-a", %T_emi% + 0.1, 0.2); bar("#emi-a-fill", %T_emi% + 0.15); fade("#emi-b", %T_emi% + 0.35, 0.2); bar("#emi-b-fill", %T_emi% + 0.4);
      for (const [k, t] of Object.entries(%LABT%)) tl.fromTo(`#${k}-w`, { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.22, ease: "back.out(2)" }, t);
      tl.fromTo("#endscrim", { opacity: 0 }, { opacity: 1, duration: 0.4 }, %T_end% - 0.1);
      tl.fromTo("#end-t", { opacity: 0, y: 40 }, { opacity: 1, y: 0, duration: 0.4, ease: "power3.out" }, %T_end% + 0.15);
      tl.fromTo("#end-cta", { opacity: 0, scale: 0.8 }, { opacity: 1, scale: 1, duration: 0.3, ease: "back.out(2)" }, %T_end% + 0.6);
      fade("#end-d", %T_end% + 0.5);
      tl.set({}, {}, DUR);

      window.__hf = window.__hf || {};
      window.__hf.buildReady = window.__hf.buildReady || {};
      window.__hf.buildReady.a380 = new Promise((resolve) => { window.__aReady = resolve; });
      window.__timelines = window.__timelines || {};
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
    <script type="module">
      import { createA380 } from "./lib/a380.js";
      const m = createA380(document.getElementById("stage"), { width: 1080, height: 1920 });
      const labels = %LABJS%;
      function place() {
        for (const [id, [anchor, dx, dy]] of Object.entries(labels)) {
          const el = document.getElementById(id);
          const p = m.project(anchor);
          if (!p) continue;
          const span = el.querySelector("span"), line = el.querySelector("i");
          const hw = span.offsetWidth / 2, sx = Math.max(50 + hw, Math.min(1030 - hw, p.x + dx)), sy = p.y + dy;
          span.style.left = `${sx}px`; span.style.top = `${sy}px`;
          const ex = sx - p.x, ey = sy - p.y, len = Math.hypot(ex, ey);
          const cut = Math.min(len, Math.abs(ey) > 1 ? (span.offsetHeight / 2 + 4) * len / Math.abs(ey) : hw);
          const L = Math.max(0, len - Math.min(cut, len));
          line.style.left = `${p.x}px`; line.style.top = `${p.y - 2}px`; line.style.width = `${L}px`;
          line.style.transform = `rotate(${Math.atan2(ey, ex)}rad)`;
        }
      }
      const renderAt = (t) => { const s = window.aStateAt(t); m.render(s); place(); };
      window.addEventListener("hf-seek", (e) => renderAt(e.detail.time));
      await m.load("assets/");
      renderAt(0);
      window.__aReady();
    </script>
  </body>
</html>
